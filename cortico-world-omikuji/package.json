{
  "name": "cortico-world-omikuji",
  "version": "0.4.12",
  "type": "module",
  "description": "精灵日签：每天一张签。种子由日期与本机盐合成，同机同日恒定，换机器就不同。措辞可用内置签库，也可以让桌宠自己写并落盘。",
  "author": {
    "name": "奶糖_net",
    "url": "https://github.com/Net-ang"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Net-ang/cortico-world-omikuji.git"
  },
  "homepage": "https://github.com/Net-ang/cortico-world-omikuji#readme",
  "bugs": {
    "url": "https://github.com/Net-ang/cortico-world-omikuji/issues"
  },
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "omikuji",
    "fortune",
    "daily",
    "desktop-pet"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "精灵日签",
    "icon": "assets/icon.png",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "tags": [
      "companion",
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "精灵日签",
        "description": "每天一张签：日期加本机盐算出今天的分数与签档。措辞可用内置签库，也可以让桌宠自己写、当天落盘后原样复用。同一天在同一台机器上恒定，换机器则不同。"
      },
      "en": {
        "displayName": "Daily Omikuji",
        "description": "One fortune slip a day: the date plus a per-installation salt yields today's score and grade. The wording is either built in or written by the pet and stored for the rest of the day. Stable on the same machine, different on another."
      }
    }
  },
  "files": [
    "src",
    "data",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --test --test-isolation=none \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "preview": "node tools/preview.ts",
    "describe:self": "node --experimental-transform-types tools/describe.ts",
    "check:client": "node --experimental-transform-types tools/check-client.mjs",
    "smoke:panel": "node --experimental-transform-types tools/dom-smoke.mjs",
    "verify:host": "node --experimental-transform-types tools/host-verify.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "typescript": "^5.7.2"
  }
}
